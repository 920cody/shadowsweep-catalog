<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copy of sswkeygen used by the GitHub workflows. Kept in sync with tools/ShadowSweepWindows.KeyGen/Core in the app solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShadowSweepWindows.KeyGen</RootNamespace>
    <AssemblyName>sswkeygen</AssemblyName>
  </PropertyGroup>

</Project>
